# Bu dosyayı .env adıyla kopyalayın ve şifreleri değiştirin:
#   Windows (PowerShell): Copy-Item .env.example .env
#   macOS / Linux / Git Bash: cp .env.example .env
# .env repoya yüklenmez (.gitignore engeller). Buraya asla gerçek şifre veya anahtar yazmayın.

# PostgreSQL
POSTGRES_USER=careerai
POSTGRES_PASSWORD=degistir-bunu
POSTGRES_DB=careerai
# Kendi bilgisayarınızda çalışan kod için (konteynerler bunu servis adlarıyla kendisi ayarlar)
DATABASE_URL=postgresql+psycopg://careerai:degistir-bunu@localhost:5432/careerai

# Redis
REDIS_URL=redis://localhost:6379/0

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Backend
JWT_SECRET=uzun-rastgele-bir-deger

# Veri toplama (opsiyonel; boşsa YouTube'dan kaynak çekilmez)
YOUTUBE_API_KEY=
