# Bu dosyayı .env adıyla kopyalayın ve şifreleri değiştirin:
#   Windows (PowerShell): Copy-Item .env.example .env
#   macOS / Linux / Git Bash: cp .env.example .env
# .env repoya yüklenmez (.gitignore engeller). Buraya asla gerçek şifre veya anahtar yazmayın.

# PostgreSQL
POSTGRES_USER=careerai
POSTGRES_PASSWORD=degistir-bunu
POSTGRES_DB=careerai
# Kendi bilgisayarınızda çalışan kod için (konteynerler bunu servis adlarıyla kendisi ayarlar).
# localhost değil 127.0.0.1: Windows'ta localhost önce IPv6'yı (::1) dener ve her bağlantı ~2 dk bekleyebilir.
DATABASE_URL=postgresql+psycopg://careerai:degistir-bunu@127.0.0.1:5432/careerai

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# Backend (kimlik doğrulama, T-037)
# local: geliştirme. Lokal giriş/kayıt için şart; yazılmazsa backend token üretmez (güvenlik önlemi).
ENVIRONMENT=local
# Lokalde boş bırakın: ENVIRONMENT=local iken backend kendi geliştirme anahtarını kullanır.
# Staging/production'da zorunlu, en az 32 karakter, rastgele. Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# KVKK rızasındaki IP hash'inin anahtarı (en az 32 karakter). Boşsa JWT_SECRET kullanılır; production'da ayrı verin.
# Boş değerle açmayın (IP_HASH_SECRET=): boş metin de 32 karakter kuralına takılır ve backend açılmaz.
# IP_HASH_SECRET=

# E2E testlerinin sahte kullanıcısı (backend/scripts/seed_test_user.py; sadece local/test).
# E-posta @example.com ile bitmeli, şifre en az 8 karakter. Gerçek e-posta veya şifre yazmayın.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Veri toplama (opsiyonel; boşsa YouTube'dan kaynak çekilmez)
YOUTUBE_API_KEY=
