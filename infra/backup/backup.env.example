# Sunucuda /etc/careerai/backup.env olarak kopyalanır (sahibi root, chmod 600). Gerçek değerler repoya girmez.
# Depolardan birini seçin (README.md "Depo seçimi").

# Hetzner Storage Box (SFTP). root'un SSH anahtarı Storage Box'a eklenmiş olmalı; port 23.
RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:careerai
# Backblaze B2:
# RESTIC_REPOSITORY=b2:careerai-yedek:/careerai
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=

# Deponun şifreleme parolası. Kaybolursa yedekler açılamaz: ekibin parola yöneticisinde de saklayın.
RESTIC_PASSWORD_FILE=/etc/careerai/restic-password
