# Günlük Postgres yedeği (T-068). Örnek adı ortamdır: careerai-backup@staging.service
# Kurulum ve elle çalıştırma: infra/backup/README.md
[Unit]
Description=CareerAI Postgres yedeği (%i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/careerai/backup.env
# bash ile: dosya izni kopyalama sırasında kaybolsa da (203/EXEC) yedek çalışır.
ExecStart=/usr/bin/bash /home/deploy/careerai/infra/backup/backup.sh %i /home/deploy/careerai/infra/%i
Nice=10
IOSchedulingClass=idle
