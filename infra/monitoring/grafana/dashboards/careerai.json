    {
      "id": 13,
      "type": "timeseries",
      "title": "Analiz süresi",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "careerai-db"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "careerai-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(completed_at, '1h'),\n  avg(duration_ms) / 1000.0 AS \"ortalama\",\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) / 1000.0 AS \"p95\"\nFROM analyses\nWHERE status = 'done' AND $__timeFilter(completed_at)\nGROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Başarılı analizler, saatlik (analyses.duration_ms)"
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Analiz sayısı",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "careerai-db"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "careerai-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(completed_at, '1h'),\n  count(*) FILTER (WHERE status = 'done') AS \"başarılı\",\n  count(*) FILTER (WHERE status = 'failed') AS \"hatalı\"\nFROM analyses\nWHERE status IN ('done', 'failed') AND $__timeFilter(completed_at)\nGROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
