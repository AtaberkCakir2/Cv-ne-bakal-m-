      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "careerai-db"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "careerai-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.started_at AS \"başlangıç\", s.name AS \"kaynak\", r.status AS \"durum\",\n  r.fetched AS \"çekilen\", r.inserted AS \"yeni\", r.duplicates AS \"tekrar\", r.errors AS \"hata\"\nFROM scrape_runs r JOIN job_sources s ON s.id = r.source_id\nORDER BY r.started_at DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
