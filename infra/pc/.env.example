# Production ve prova ortamı ayarları (karar #30). Bu PC'de kopyalanır, repoya girmez (.gitignore: .env.*):
#   cp infra/pc/.env.example infra/pc/.env.prod      (APP_ENVIRONMENT=production)
#   cp infra/pc/.env.example infra/pc/.env.staging   (APP_ENVIRONMENT=staging, TUNNEL_TOKEN boş)
# İki dosyada şifreler FARKLI olmalı. Rastgele değer: openssl rand -hex 32 (Git Bash'te çalışır; hex olsun,
# adresin içine girdiği için özel karakter sorun çıkarır).

APP_ENVIRONMENT=production

# Projenin Docker ağı; api sadece bu alt ağdan gelen X-Forwarded-For'a güvenir (istek sınırları).
# production: 172.31.10.0/24, staging: 172.31.11.0/24. İki ortam aynı anda çalıştığı için farklı olmalı.
COMPOSE_SUBNET=172.31.10.0/24

POSTGRES_USER=careerai
POSTGRES_DB=careerai
POSTGRES_PASSWORD=
# API ve veri işçisinin en az yetkili rolü careerai_app (T-075). Sadece harf/rakam (openssl rand -hex 32).
APP_DB_PASSWORD=
REDIS_PASSWORD=

JWT_SECRET=
IP_HASH_SECRET=

# JSON listesi, ör. ["https://app.cvnebakalim.com"]. Web arayüzü yayına çıkınca doldurulur.
CORS_ORIGINS=[]
FRONTEND_URL=

YOUTUBE_API_KEY=

# Cloudflare Tunnel (T-010): Zero Trust → Networks → Tunnels → tünel → token. Sadece production'da doldurun.
TUNNEL_TOKEN=

# Yönetim paneli için Cloudflare Access (backend/app/admin/README.md). Sır değil ama ortama özel. Boşsa production'da
# /admin 503 döner. Zero Trust → Access controls → Applications → "Cv'ne Bakalım! admin" → Application Audience (AUD) Tag.
CF_ACCESS_TEAM_DOMAIN=old-firefly-f6cd.cloudflareaccess.com
CF_ACCESS_AUD=

# Yedek (T-068, infra/backup/README.md): restic deposu PC dışında. Sadece production'da doldurun.
# Parola kaybolursa yedekler açılamaz: ekibin parola yöneticisinde de saklayın.
RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/cvnebakalim-yedek/careerai
RESTIC_PASSWORD=
# Backblaze uygulama anahtarı: keyID ve applicationKey (S3 adresiyle kullanılır, infra/backup/README.md).
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# İzleme (T-066, infra/monitoring/README.md). Sadece production'da doldurun.
# Grafana: http://127.0.0.1:3000, kullanıcı admin. Şifre boşsa Grafana açılmaz.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
# Salt okunur careerai_monitor veri tabanı rolünün şifresi (deploy.sh rolü oluşturur/günceller).
MONITOR_DB_PASSWORD=

# Açılacak isteğe bağlı servisler. Production: tunnel,backup,monitoring. Prova ortamında boş bırakın.
COMPOSE_PROFILES=tunnel,backup,monitoring

# Sunum B planı: api'nin bu PC'de açılacağı port (compose.local.yml).
LOCAL_API_PORT=8100
