# Production ve prova ortamı ayarları (karar #30). Bu PC'de kopyalanır, repoya girmez (.gitignore: .env.*):
#   cp infra/pc/.env.example infra/pc/.env.prod      (APP_ENVIRONMENT=production)
#   cp infra/pc/.env.example infra/pc/.env.staging   (APP_ENVIRONMENT=staging, TUNNEL_TOKEN boş)
# İki dosyada şifreler FARKLI olmalı. Rastgele değer: openssl rand -hex 32 (Git Bash'te çalışır; hex olsun,
# adresin içine girdiği için özel karakter sorun çıkarır).

APP_ENVIRONMENT=production

POSTGRES_USER=careerai
POSTGRES_DB=careerai
POSTGRES_PASSWORD=
REDIS_PASSWORD=

JWT_SECRET=
IP_HASH_SECRET=

# JSON listesi, ör. ["https://app.cvnebakalim.com"]. Web arayüzü yayına çıkınca doldurulur.
CORS_ORIGINS=[]
FRONTEND_URL=

YOUTUBE_API_KEY=

# Cloudflare Tunnel (T-010): Zero Trust → Networks → Tunnels → tünel → token. Sadece production'da doldurun.
TUNNEL_TOKEN=

# Yedek (T-068, infra/backup/README.md): restic deposu PC dışında. Sadece production'da doldurun.
# Parola kaybolursa yedekler açılamaz: ekibin parola yöneticisinde de saklayın.
RESTIC_REPOSITORY=b2:cvnebakalim-yedek:/careerai
RESTIC_PASSWORD=
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Açılacak isteğe bağlı servisler. Production: tunnel,backup. Prova ortamında boş bırakın.
COMPOSE_PROFILES=tunnel,backup

# Sunum B planı: api'nin bu PC'de açılacağı port (compose.local.yml).
LOCAL_API_PORT=8100
