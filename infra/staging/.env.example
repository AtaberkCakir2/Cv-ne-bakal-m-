# Staging ayarları. Sunucuda: cp .env.example .env && chmod 600 .env
# Rastgele değer için: openssl rand -hex 32 (hex olsun, adresin içine girdiği için özel karakter sorun çıkarır).

STAGING_API_DOMAIN=staging-api.ornek.com
ACME_EMAIL=

POSTGRES_USER=careerai
POSTGRES_DB=careerai
POSTGRES_PASSWORD=
REDIS_PASSWORD=

JWT_SECRET=
IP_HASH_SECRET=

# JSON listesi, ör. ["https://app.ornek.com"]. Web arayüzü yayına çıkınca doldurulur.
CORS_ORIGINS=[]
FRONTEND_URL=

YOUTUBE_API_KEY=
