# Staging giriş noktası (T-035). Sertifikayı Caddy otomatik alır ve yeniler.
{
	email {$ACME_EMAIL}
}

{$STAGING_API_DOMAIN} {
	encode zstd gzip

	# CV sınırı 5 MB (API de denetler); daha büyüğü API'ye ulaşmadan reddedilir.
	request_body {
		max_size 6MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy api:8000
}
