{
  "name": "careerai-desktop",
  "productName": "Cv'ne Bakalım!",
  "version": "0.1.0",
  "private": true,
  "description": "Cv'ne Bakalım! masaüstü uygulaması (Electron, T-059)",
  "author": "Cv'ne Bakalım! ekibi",
  "main": "main.cjs",
  "scripts": {
    "web": "npm --prefix .. run build",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "check:api": "node check-api.cjs",
    "dist:win": "npm run check:api && npm run web && electron-builder --win nsis",
    "dist:mac": "npm run check:api && npm run web && electron-builder --mac",
    "release:win": "npm run check:api && npm run web && electron-builder --win nsis --publish always",
    "release:mac": "npm run check:api && npm run web && electron-builder --mac --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.cvnebakalim.careerai",
    "productName": "Cv'ne Bakalım!",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CvneBakalim-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.education",
      "artifactName": "CvneBakalim-${version}-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "AtaberkCakir2",
      "repo": "Cv-ne-bakal-m-"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true
    }
  }
}
